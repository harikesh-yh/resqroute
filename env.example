# Copy to .env. Never commit .env — the key lives in the server process only.

# Which provider implementation the factory selects. Nothing about the rest of
# the system is Anthropic-specific; see server/src/llm/factory.ts.
LLM_PROVIDER=anthropic          # anthropic | openai
LLM_API_KEY=
LLM_MODEL=claude-opus-5

# Simulation
SIM_TIME_SCALE=6                # sim seconds per wall second
CITY=mumbai
PORT=8787

# Boot from a recorded run instead of calling any provider. Empty = live agents.
REPLAY_MODE=
